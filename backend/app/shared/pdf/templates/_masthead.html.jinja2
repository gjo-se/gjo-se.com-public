{# ─────────────────────────────────────────────────────────────────────────
   PDF-Partial: Masthead (Marke + Wortmarke + USP) – selbst-enthaltend.
   Enthält Markup UND zugehöriges CSS; das <style> im <body> ist von
   WeasyPrint verifiziert (gilt global, unabhängig von der Position).

   Verwendung (Brand-/Endkunden-Variante): als erstes Element im <body>:
       {% include "_masthead.html.jinja2" %}

   Das Standard-CV (Broker-facing) bindet dieses Partial bewusst NICHT ein:
   Vermittler anonymisieren und formatieren den CV beim Weiterleiten um
   (eigenes Logo/Kontaktdaten), Hays rät im CV-Leitfaden explizit von Logos
   und Bildern ab. Die Marke ist weiterhin zentral persistiert über die
   SSOT-Assets in frontend/public/brand/ und das Mail-Partial
   `emails/_masthead.mjml`.
   ───────────────────────────────────────────────────────────────────────── #}
<style>
  /* ══ Masthead: Brand (Marke + Wortmarke) + USP ══════════════════════ */
  .cv-masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12pt;
    margin-bottom: 6pt;
  }

  .cv-brand {
    display: flex;
    align-items: center;
    gap: 8pt;
  }

  .cv-logo {
    width: 7mm;
    height: 7mm;
    flex-shrink: 0;
  }

  .cv-masthead__usp {
    font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 8.5pt;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9A227;
    white-space: nowrap;
  }

  /* Struktur-Trennlinie (identisch zum Footer-Top). */
  .cv-masthead__rule {
    border: none;
    border-top: 1pt solid #DCD6C9;
    margin: 0 0 14pt 0;
  }

  /* ── Wordmark gjo:Se – struktur-treu (Sans + Gold-„:" + Serif-„Se") ── */
  .cv-wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: 'Geist Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-size: 18pt;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #14141A;
  }

  .cv-wordmark__sep { color: #C9A227; }

  .cv-wordmark__serif {
    font-family: 'Instrument Serif', ui-serif, Georgia, serif;
    font-weight: 400;
  }

  .cv-wordmark__underline {
    display: block;
    width: 100%;
    height: 1.5pt;
    background-color: #C9A227;
    margin-top: 2pt;
  }

  /* ── Print / Umbruch-Steuerung (gehört zum Partial) ── */
  @media print {
    .cv-masthead {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .cv-masthead__rule {
      break-after: avoid;
      page-break-after: avoid;
    }
  }
</style>

<!-- ═══ Masthead: Brand (Marke + Wortmarke) + USP, abgetrennt ═══ -->
<div class="cv-masthead">
  <div class="cv-brand">
    <svg class="cv-logo" xmlns="http://www.w3.org/2000/svg" viewBox="16 23 30 30" role="img" aria-label="gjo:Se">
      <defs>
        <linearGradient id="cv-logo-gd" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#C9A227"/>
          <stop offset="1" stop-color="#6E5613"/>
        </linearGradient>
      </defs>
      <path fill="url(#cv-logo-gd)" d="M22 24 L44 38 L22 52 L18 50 L30 38 L18 26 Z"/>
    </svg>
    <span class="cv-wordmark">
      <span class="cv-wordmark__text">gjo<span class="cv-wordmark__sep">:</span><span class="cv-wordmark__serif">Se</span></span>
      <span class="cv-wordmark__underline" aria-hidden="true"></span>
    </span>
  </div>
  <span class="cv-masthead__usp">AI &middot; Architecture &middot; Clean Code</span>
</div>
<hr class="cv-masthead__rule"/>
