{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "build:deploy": "vite build",
    "lint": "eslint . --config eslint.config.ts --fix --max-warnings 0",
    "lint:report": "tsx ../scripts/pre-commit/frontend/eslint/report.ts",
    "lint:arch": "eslint . --config eslint.config.arch.ts --max-warnings 0",
    "lint:arch:report": "tsx ../scripts/pre-commit/frontend/eslint/report-arch.ts",
    "lint:jsdoc": "eslint . --config eslint.config.jsdoc.ts --max-warnings 0",
    "lint:jsdoc:report": "tsx ../scripts/pre-commit/frontend/eslint/report-jsdoc.ts",
    "lint:test": "eslint . --config eslint.config.test.ts --max-warnings 0",
    "lint:test:report": "tsx ../scripts/pre-commit/frontend/eslint/report-test.ts",
    "lint:verify": "tsx ../scripts/pre-commit/frontend/eslint/verify-config-split.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:hook": "tsx ../scripts/pre-commit/frontend/checks/frontend-tsc.ts",
    "routes:fe-fe": "tsx ../scripts/pre-commit/frontend/checks/routes-fe-fe.ts",
    "dead-code": "tsx ../scripts/pre-commit/frontend/checks/dead-code.ts",
    "barrel-structure": "tsx ../scripts/pre-commit/frontend/checks/barrel-structure.ts",
    "check:complexity": "tsx ../scripts/pre-commit/frontend/checks/complexity.ts",
    "check:file-length": "tsx ../scripts/pre-commit/frontend/checks/file-length.ts",
    "check:test-structure": "tsx ../scripts/pre-commit/frontend/checks/test-structure.ts",
    "check:test-orphans": "tsx ../scripts/pre-commit/frontend/checks/test-orphans.ts",
    "check:single-responsibility": "tsx ../scripts/pre-commit/frontend/checks/single-responsibility.ts",
    "check:unit-no-network": "tsx ../scripts/pre-commit/frontend/checks/unit-no-network.ts",
    "check:test-antipatterns": "tsx ../scripts/pre-commit/frontend/checks/test-antipatterns.ts",
    "lint:suppressions": "tsx ../scripts/pre-commit/frontend/checks/linter-suppressions.ts",
    "npm-audit": "tsx ../scripts/pre-commit/frontend/checks/npm-audit.ts",
    "list-checks": "tsx ../scripts/pre-commit/frontend/checks/list-checks.ts",
    "pattern-mapper:check": "cd ../backend && uv run python ../scripts/pre-commit/global/regenerate_pattern_mapper.py --check",
    "generate:block": "cd ../backend && uv run python ../scripts/pre-commit/global/generate_block.py",
    "generate:stories": "tsx ../scripts/pre-commit/frontend/generate/generate-stories.ts",
    "generate:stories:check": "tsx ../scripts/pre-commit/frontend/generate/generate-stories.ts --check",
    "scan-content": "tsx ../scripts/scan-content-keys.ts",
    "preview": "vite preview",
    "knip": "knip --production",
    "trace:bulk-merge": "node ../docs/_temp/bulk-merge-fe-trace.cjs",
    "trace:final": "node ../docs/_temp/trace-final.cjs",
    "pw:workflow": "node ../docs/_temp/pw-workflow.js",
    "knip:all": "knip",
    "registry:build": "shadcn build --output public/r && for f in public/r/*.json; do if [ -n \"$(tail -c1 \"$f\")\" ]; then printf '\\n' >> \"$f\"; fi; done",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "pw:server": "node ../scripts/frontend/playwright-server.mjs",
    "test:integration:headed": "PW_HEADED=1 vitest run --project integration",
    "test:watch:integration": "PW_HEADED=1 vitest --project integration",
    "test:ui": "vitest run --project ui",
    "test:watch": "vitest",
    "types:api:spec": "cd ../backend && uv run python ../scripts/pre-commit/global/export_openapi.py",
    "types:api": "npm run types:api:spec && openapi-typescript ../docs/_temp/openapi.json -o src/lib/types.generated.ts",
    "types:api:check": "npm run types:api:spec && openapi-typescript ../docs/_temp/openapi.json -o ../docs/_temp/types.generated.check.ts && diff -q ../docs/_temp/types.generated.check.ts src/lib/types.generated.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "depcruise:validate": "depcruise --config ../scripts/pre-commit/frontend/checks/dependency-cruiser-config.mjs src --validate",
    "depcruise:viscera": "depcruise --config ../scripts/pre-commit/frontend/checks/dependency-cruiser-config.mjs src/features/viscera --validate",
    "depcruise:report": "tsx ../scripts/pre-commit/frontend/checks/frontend-depcruise.ts",
    "dry:jscpd": "tsx ../scripts/pre-commit/global/dry/jscpd/index.ts",
    "dry:semantic": "tsx ../scripts/pre-commit/frontend/foundation/dry/semantic-duplicates/index.ts",
    "check:component-composition": "tsx ../scripts/pre-commit/frontend/foundation/component-composition/index.ts",
    "a11y:audit": "tsx ../scripts/dev/a11y-audit.ts",
    "visual:probe": "tsx ../scripts/frontend/visual-probe.ts",
    "validate:architecture": "tsx ../scripts/frontend/validate-architecture.ts",
    "optimize-images": "node ../scripts/frontend/optimize-images.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@mantine/carousel": "^9.4.0",
    "@mantine/core": "^9.4.0",
    "@mantine/dates": "^9.4.0",
    "@mantine/form": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@react-sigma/core": "^5.0.6",
    "@shadcn/react": "^0.1.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "elkjs": "^0.12.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "graphology": "^0.26.0",
    "immer": "^11.1.16",
    "input-otp": "^1.4.2",
    "js-yaml": "^5.2.3",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "openapi-typescript": "^7.13.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.2",
    "react-force-graph-2d": "^1.29.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router": "^8.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-vitals": "^6.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.1",
    "@lancedb/lancedb": "^0.30.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.4",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-project-structure": "^3.14.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-testing-library": "^7.1.1",
    "globals": "^16.5.0",
    "jscpd": "4.0.5",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "msw": "^2.14.6",
    "playwright": "^1.61.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "@modelcontextprotocol/sdk": "^1.31.0"
  }
}
